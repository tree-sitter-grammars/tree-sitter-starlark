{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "starlark",
      "camelcase": "Starlark",
      "scope": "source.bzl",
      "file-types": [
        "bzl",
        "bazel",
        "star",
        "sky"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^(starlark|bzl)$"
    }
  ],
  "metadata": {
    "version": "2.0.0",
    "license": "MIT",
    "description": "Starlark grammar for tree-sitter, following the language spec",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      },
      {
        "name": "Andre Brisco"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-starlark"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
