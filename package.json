{
  "name": "tree-sitter-starlark",
  "version": "2.0.0",
  "description": "Starlark grammar for tree-sitter, following the language spec",
  "type": "module",
  "repository": "https://github.com/tree-sitter-grammars/tree-sitter-starlark",
  "license": "MIT",
  "author": {
    "name": "Amaan Qureshi",
    "email": "amaanq12@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    },
    "./node-types": {
      "import": {
        "types": "./bindings/node/node-types.d.ts"
      },
      "require": {
        "types": "./bindings/node/node-types.d.cts"
      }
    },
    "./tree-sitter-starlark.wasm": "./tree-sitter-starlark.wasm",
    "./grammar.js": "./grammar.js",
    "./tree-sitter.json": "./tree-sitter.json",
    "./package.json": "./package.json",
    "./queries/*": "./queries/*",
    "./src/*": "./src/*"
  },
  "typesVersions": {
    "*": {
      "node-types": [
        "bindings/node/node-types.d.ts"
      ]
    }
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "starlark",
    "bazel"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm",
    "scripts/*"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js scripts",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test && node --test bindings/node/*_test.js && npm run test:types",
    "generate:types": "node scripts/generate-node-types.js",
    "generate": "tree-sitter generate && npm run generate:types",
    "build:wasm": "tree-sitter build --wasm",
    "test:types": "npm run build:wasm && npm --prefix test/typescript install --no-audit --no-fund && npm --prefix test/typescript test"
  }
}
